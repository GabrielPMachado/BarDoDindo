rules_version = '2';

// Regras do Bar do Dindo. Não há servidor: tudo o que o app e o CRM podem ler ou gravar é decidido aqui.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- equipe (CRM) ---------- */
    function logado() { return request.auth != null; }
    function caminho(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function daEquipe() {
      return logado() && exists(caminho('usuarios', request.auth.uid))
        && get(caminho('usuarios', request.auth.uid)).data.status == 'Ativo';
    }
    function funcao() {
      return get(caminho('funcoes', get(caminho('usuarios', request.auth.uid)).data.funcaoId)).data;
    }
    // permissões da função em cada área: lista com "ver", "criar", "editar" e "excluir".
    // Formato antigo (um nível por área) continua valendo: "edit" = todas, "view" = só ver.
    // A função Administrador (de sistema) pode tudo, inclusive em áreas criadas depois.
    function permissao(area) { return funcao().get('permissoes', {}).get(area, 'none'); }
    function pode(area, acao) {
      return daEquipe() && (
        funcao().get('sistema', false) == true
        || (permissao(area) is list && acao in permissao(area))
        || (permissao(area) is string && (permissao(area) == 'edit' || (permissao(area) == 'view' && acao == 'ver'))));
    }
    function podeVer(area) { return pode(area, 'ver'); }
    // cópias espelhadas, histórico e saldos acompanham qualquer alteração na área
    function podeAlterar(area) { return pode(area, 'criar') || pode(area, 'editar') || pode(area, 'excluir'); }

    // área (permissão) de cada coleção de cadastro do CRM
    function areas() {
      return {
        'metas': 'dir',
        'colaboradores': 'rh', 'ferias': 'rh',
        'projetos': 'dp', 'estoque': 'dp', 'materiais': 'dp',
        'terceirizados': 'adm', 'fornecedores': 'adm', 'contratos': 'adm',
        'receitas': 'fin', 'despesas': 'fin',
        'reservas': 'atd', 'consumos': 'atd', 'resgates': 'atd',
        'criacao': 'mkt', 'midias': 'mkt', 'produtos': 'mkt', 'recompensas': 'mkt',
        'trabalhista': 'jur', 'consultoria': 'jur',
        'qualidade': 'fis', 'naoconformidades': 'fis'
      };
    }
    match /{col}/{id} {
      allow read: if col in areas() && podeVer(areas()[col]);
      allow create: if col in areas() && pode(areas()[col], 'criar');
      allow update: if col in areas() && pode(areas()[col], 'editar');
      allow delete: if col in areas() && pode(areas()[col], 'excluir');
    }

    /* ---------- painel de atualizações ---------- */
    // histórico de quem fez o quê: cada área vê o próprio; só se acrescenta, nunca se altera ou apaga
    match /atividades/{area}/itens/{id} {
      allow read: if podeVer(area);
      allow create: if podeAlterar(area)
        && request.resource.data.keys().hasOnly(['area', 'acao', 'colecao', 'alvo', 'detalhe', 'usuarioId', 'usuarioNome', 'criadoEm'])
        && request.resource.data.area == area
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioNome == get(caminho('usuarios', request.auth.uid)).data.nome
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 120
        && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 160
        && request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 300;
    }

    /* ---------- preferências de cada usuário (painel executivo personalizado) ---------- */
    // cada painel (executivo e "Meu painel") guarda só listas curtas de identificadores
    function painelOk(p) {
      return p.keys().hasOnly(['ordem', 'fixados', 'ocultos', 'atalhos', 'extras'])
        && p.get('ordem', []) is list && p.get('ordem', []).size() <= 60
        && p.get('fixados', []) is list && p.get('fixados', []).size() <= 60
        && p.get('ocultos', []) is list && p.get('ocultos', []).size() <= 60
        && p.get('atalhos', []) is list && p.get('atalhos', []).size() <= 30
        && p.get('extras', []) is list && p.get('extras', []).size() <= 60;
    }
    match /preferencias/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if daEquipe() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['painel', 'meuPainel', 'paginas', 'atualizadoEm'])
        && request.resource.data.get('paginas', []) is list && request.resource.data.get('paginas', []).size() <= 30
        && painelOk(request.resource.data.get('painel', {}))
        && painelOk(request.resource.data.get('meuPainel', {}));
    }

    /* ---------- primeiro acesso ---------- */
    // o primeiro administrador, a função Administrador e a marca de "configurado" são gravados juntos, uma única vez
    function primeiroAcesso() {
      return logado()
        && !exists(caminho('meta', 'setup')) && existsAfter(caminho('meta', 'setup'))
        && getAfter(caminho('usuarios', request.auth.uid)).data.funcaoId == 'admin';
    }
    match /meta/setup {
      allow read: if true;
      allow create: if primeiroAcesso();
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || daEquipe());
      allow create: if pode('cfg', 'criar') || (request.auth.uid == uid && primeiroAcesso());
      allow update: if pode('cfg', 'editar')
        || (logado() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso']))
        // Meu perfil: a própria pessoa edita nome, telefone, nascimento, "sobre mim" e foto (nunca função, status ou e-mail)
        || (daEquipe() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'nascimento', 'sobre', 'foto'])
          && (request.resource.data.get('foto', null) == null || (request.resource.data.foto is string && request.resource.data.foto.size() <= 400000))
          && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
          && request.resource.data.get('telefone', '') is string && request.resource.data.get('telefone', '').size() <= 20
          && request.resource.data.get('nascimento', '') is string && request.resource.data.get('nascimento', '').size() <= 10
          && request.resource.data.get('sobre', '') is string && request.resource.data.get('sobre', '').size() <= 500);
      allow delete: if pode('cfg', 'excluir') && request.auth.uid != uid;
    }

    match /funcoes/{id} {
      allow read: if daEquipe();
      allow create: if (pode('cfg', 'criar') && request.resource.data.get('sistema', false) != true)
        || (id == 'admin' && primeiroAcesso());
      allow update: if pode('cfg', 'editar') && resource.data.get('sistema', false) != true && request.resource.data.get('sistema', false) != true;
      allow delete: if pode('cfg', 'excluir') && resource.data.get('sistema', false) != true;
    }

    match /config/{id} {
      allow read: if true;
      allow write: if pode('cfg', 'editar');
    }

    /* ---------- cópias com dados reduzidos ---------- */
    // cardápio público (sem custo nem margem dos produtos)
    match /cardapio/{id} {
      allow read: if true;
      allow write: if podeAlterar('mkt');
    }
    // nomes para vincular registros, visíveis a toda a equipe (sem salários nem contatos)
    match /ref_colaboradores/{id} {
      allow read: if daEquipe();
      allow write: if podeAlterar('rh');
    }
    match /ref_fornecedores/{id} {
      allow read: if daEquipe();
      allow write: if podeAlterar('adm');
    }

    /* ---------- acessos cruzados entre áreas ---------- */
    // o Financeiro calcula a folha a partir do cadastro do RH
    match /colaboradores/{id} {
      allow read: if podeVer('fin');
    }
    // o Atendimento lança consumo com os preços do cadastro de produtos
    match /produtos/{id} {
      allow read: if podeVer('atd');
    }
    // o lançamento de consumo (Atendimento) gera e estorna a própria receita
    match /receitas/{id} {
      allow create: if pode('atd', 'criar') && request.resource.data.consumoId is string;
      allow delete: if pode('atd', 'excluir') && resource.data.get('consumoId', null) != null;
    }

    /* ---------- afilhados (aplicativo) ---------- */
    function novoCliente() {
      return logado() && !exists(caminho('clientes', request.auth.uid)) && existsAfter(caminho('clientes', request.auth.uid));
    }
    // contador que dá o número sequencial de afilhado: só anda de um em um, junto com um cadastro novo
    match /meta/contadores {
      allow read: if true;
      allow create: if request.resource.data.clientes == 1 && novoCliente();
      allow update: if request.resource.data.clientes == resource.data.clientes + 1 && novoCliente();
    }
    match /clientes/{uid} {
      allow read: if logado() && (request.auth.uid == uid || podeVer('atd') || podeVer('mkt'));
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.numero == getAfter(caminho('meta', 'contadores')).data.clientes
        && existsAfter(caminho('saldos', uid));
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'foto']);
    }

    // saldo de pontos usado para validar resgates: quem credita é a equipe; o cliente só debita junto com um voucher
    match /saldos/{uid} {
      allow read: if logado() && (request.auth.uid == uid || podeVer('atd') || podeVer('mkt'));
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['acumulados', 'usados', 'ultimoResgate'])
        && request.resource.data.acumulados == 0 && request.resource.data.usados == 0;
      allow write: if podeAlterar('atd');
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usados', 'ultimoResgate'])
        && request.resource.data.ultimoResgate != resource.data.ultimoResgate
        && !exists(caminho('resgates', request.resource.data.ultimoResgate))
        && getAfter(caminho('resgates', request.resource.data.ultimoResgate)).data.clienteUid == uid
        && request.resource.data.usados == resource.data.usados + getAfter(caminho('resgates', request.resource.data.ultimoResgate)).data.custo
        && request.resource.data.usados <= resource.data.acumulados;
    }

    match /recompensas/{id} {
      allow read: if resource.data.status == 'Ativa';
    }

    match /reservas/{id} {
      allow read: if logado() && resource.data.clienteUid == request.auth.uid;
      allow create: if logado() && request.resource.data.clienteUid == request.auth.uid
        && exists(caminho('clientes', request.auth.uid))
        && request.resource.data.status == 'Pendente' && request.resource.data.origem == 'Aplicativo';
      allow update: if logado() && resource.data.clienteUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && request.resource.data.status == 'Cancelada pelo cliente'
        && resource.data.status in ['Pendente', 'Confirmada'];
    }

    match /consumos/{id} {
      allow read: if (logado() && resource.data.clienteUid == request.auth.uid) || podeVer('mkt');
    }

    match /resgates/{id} {
      allow read: if (logado() && resource.data.clienteUid == request.auth.uid) || podeVer('mkt');
      allow create: if logado() && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == 'Disponível'
        && get(caminho('recompensas', request.resource.data.recompensaId)).data.status == 'Ativa'
        && request.resource.data.custo == get(caminho('recompensas', request.resource.data.recompensaId)).data.custo
        && request.resource.data.custo > 0
        && getAfter(caminho('saldos', request.auth.uid)).data.ultimoResgate == id;
    }
  }
}
