rules_version = '2';

// Regras do Bar do Dindo. Não há servidor: tudo o que o app e o CRM podem ler ou gravar é decidido aqui.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- equipe (CRM) ---------- */
    function logado() { return request.auth != null; }
    function caminho(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function daEquipe() {
      return logado() && exists(caminho('usuarios', request.auth.uid))
        && get(caminho('usuarios', request.auth.uid)).data.status == 'Ativo';
    }
    function funcao() {
      return get(caminho('funcoes', get(caminho('usuarios', request.auth.uid)).data.funcaoId)).data;
    }
    // permissões da função em cada área: lista com "ver", "criar", "editar" e "excluir".
    // Formato antigo (um nível por área) continua valendo: "edit" = todas, "view" = só ver.
    // A função Administrador (de sistema) pode tudo, inclusive em áreas criadas depois.
    // Uma permissão por módulo (tela ou cadastro). Funções gravadas antes da separação não têm o módulo:
    // valem as da área a que ele pertence; e Vendas, separada de Marketing, herda as de Marketing.
    // Igual a PAI_DO_MODULO em shared/backend.ts.
    function pai(k) {
      return k.matches('reservas|consumos|resgates|eventos|caixas|comandas|mesas') ? 'atd'
        : k.matches('produtos|fichas|guarnicoes|clientes|qrcode') ? 'vnd'
        : k.matches('recompensas|criacao|midias|publicidade') ? 'mkt'
        : k.matches('projetos|estoque|materiais|patrimonio|compras') ? 'dp'
        : k.matches('terceirizados|fornecedores|precos|contratos') ? 'adm'
        : k.matches('qualidade|atestados|naoconformidades') ? 'fis'
        : k.matches('receitas|despesas.*|resultado|ticket|renda|acoes|creditos|docfin|relatorios|investimentos') ? 'fin'
        : k.matches('colaboradores|prestadores.*|folha|ferias|afastamentos|conduta') ? 'rh'
        : k.matches('consultoria|trabalhista|advogados.*|normas.*') ? 'jur'
        : k.matches('logs|chamados|equipamentos') ? 'ti'
        : k.matches('usuarios|funcoes|parametros') ? 'cfg'
        : k.matches('painel|metas') ? 'dir' : '-';
    }
    function legado(area) { return { 'vnd': 'mkt' }.get(area, '-'); }
    // telas que mostram parte de um cadastro (ex.: só as despesas fixas): sem a tela, vale a do cadastro. Igual a BASE_DA_PAGINA.
    function base(k) {
      return k.matches('despesas_.*') ? 'despesas' : k.matches('advogados_.*') ? 'advogados' : k.matches('normas_.*') ? 'normas'
        : k == 'fichas' ? 'produtos' : k.matches('ticket|renda') ? 'resultado' : k == 'relatorios' ? 'docfin'
        : k == 'prestadores_pj' ? 'prestadores' : k == 'afastamentos' ? 'ferias' : k;
    }
    // telas-parte de cada cadastro, além do próprio (Igual a PAGINAS_DA_COLECAO): quem tem alguma delas usa o cadastro
    function paginasExtras(col) {
      return !col.matches('produtos|despesas|docfin|prestadores|ferias|advogados|normas') ? [] : {
        'produtos': ['fichas'], 'despesas': ['despesas_variaveis', 'despesas_fixas'], 'docfin': ['relatorios'],
        'prestadores': ['prestadores_pj'], 'ferias': ['afastamentos'],
        'advogados': ['advogados_trabalhista', 'advogados_empresarial'], 'normas': ['normas_trabalhista', 'normas_empresarial']
      }[col];
    }
    // a área (pai) só é calculada quando a função não tem o próprio módulo (formato antigo)
    function herdada(permissoes, a, k) {
      return a in permissoes ? permissoes[a] : permissoes.get(legado(a), permissoes.get(legado(k), 'none'));
    }
    // só as telas-parte (com "_" ou de nome próprio) passam pelo base(): as demais já são o próprio cadastro
    function acoesEm(permissoes, k) {
      return k in permissoes ? permissoes[k]
        // páginas criadas depois das funções: valem as da página mais próxima (Igual a IRMA_DA_PAGINA)
        : k.matches('caixas|comandas|mesas|qrcode') && irma(k) in permissoes ? permissoes[irma(k)]
        : acoesBase(permissoes, k.matches('.*_.*|fichas|ticket|renda|relatorios|afastamentos') ? base(k) : k);
    }
    function irma(k) { return k.matches('caixas|comandas') ? 'consumos' : k == 'mesas' ? 'reservas' : 'clientes'; }
    function acoesBase(permissoes, b) { return b in permissoes ? permissoes[b] : herdada(permissoes, pai(b), b); }
    function temAcao(p, acao) { return (p is list && acao in p) || (p is string && (p == 'edit' || (p == 'view' && acao == 'ver'))); }
    function podeNaFuncao(f, area, acao) {
      return f.get('sistema', false) == true || temAcao(acoesEm(f.get('permissoes', {}), area), acao);
    }
    // vários módulos numa checagem só (a função é lida uma vez): acessos cruzados entre telas
    function emAlgum(f, mods, acao) {
      let ps = f.get('permissoes', {});
      return f.get('sistema', false) == true
        || temAcao(acoesEm(ps, mods[0]), acao)
        || (mods.size() > 1 && temAcao(acoesEm(ps, mods[1]), acao))
        || (mods.size() > 2 && temAcao(acoesEm(ps, mods[2]), acao))
        || (mods.size() > 3 && temAcao(acoesEm(ps, mods[3]), acao))
        || (mods.size() > 4 && temAcao(acoesEm(ps, mods[4]), acao));
    }
    function podeEmAlgum(mods, acao) { return daEquipe() && emAlgum(funcao(), mods, acao); }
    // um cadastro: o próprio (com a herança completa) ou uma tela-parte gravada na função — sem a tela gravada, ela vale
    // o mesmo que o cadastro, que já foi conferido
    function colecaoNaFuncao(f, col, acao) {
      let ps = f.get('permissoes', {});
      let extras = paginasExtras(col);
      return f.get('sistema', false) == true || temAcao(acoesEm(ps, col), acao)
        || (extras.size() > 0 && extras[0] in ps && temAcao(ps[extras[0]], acao))
        || (extras.size() > 1 && extras[1] in ps && temAcao(ps[extras[1]], acao));
    }
    function podeColecao(col, acao) { return daEquipe() && colecaoNaFuncao(funcao(), col, acao); }
    function pode(area, acao) { return daEquipe() && podeNaFuncao(funcao(), area, acao); }
    function podeVer(area) { return pode(area, 'ver'); }
    // cópias espelhadas, histórico e saldos acompanham qualquer alteração na área
    function podeAlterar(area) { return pode(area, 'criar') || pode(area, 'editar') || pode(area, 'excluir'); }
    // função Administrador (de sistema): a única que pode zerar o sistema
    function sistema() { return daEquipe() && funcao().get('sistema', false) == true; }
    // zerar o sistema: o último lote apaga o registro do primeiro acesso junto com o próprio usuário e a função Administrador
    function zerando() { return sistema() && !existsAfter(caminho('meta', 'setup')); }

    // cadastros do CRM: cada um é o próprio módulo (permissão)
    function colecoesCrm() {
      return ['metas', 'colaboradores', 'ferias', 'projetos', 'estoque', 'materiais', 'patrimonio', 'compras', 'terceirizados', 'fornecedores', 'contratos', 'precos',
        'receitas', 'despesas', 'reservas', 'consumos', 'resgates', 'criacao', 'midias', 'recompensas', 'produtos', 'guarnicoes',
        'trabalhista', 'consultoria', 'qualidade', 'naoconformidades', 'eventos', 'publicidade', 'atestados',
        'acoes', 'creditos', 'docfin', 'investimentos', 'prestadores', 'conduta', 'advogados', 'normas', 'chamados', 'equipamentos',
        'caixas', 'comandas', 'mesas'];
    }
    match /{col}/{id} {
      allow read: if col in colecoesCrm() && podeColecao(col, 'ver');
      allow create: if col in colecoesCrm() && podeColecao(col, 'criar');
      // caixa fechado não muda mais (nem as sangrias e os suprimentos dele, nem as vendas que entraram nele)
      allow update: if col in colecoesCrm() && podeColecao(col, 'editar') && (col != 'caixas' || resource.data.status == 'Aberto')
        && (col != 'consumos' || get(caminho('caixas', resource.data.caixaId)).data.status == 'Aberto');
      allow delete: if col in colecoesCrm() && podeColecao(col, 'excluir') && (!(col in ['consumos', 'receitas']) || vendaDeCaixaAberto(resource.data));
    }
    // venda (consumo ou a receita dela) só é estornada com o caixa em que entrou aberto; vendas de antes do caixa não têm caixaId.
    // Excluir o afilhado (LGPD, exige excluir em Afilhados) apaga os consumos dele mesmo de caixas fechados
    function vendaDeCaixaAberto(d) {
      return !('caixaId' in d) || get(caminho('caixas', d.caixaId)).data.status == 'Aberto' || pode('clientes', 'excluir');
    }

    // caixa: quem lança consumo ou fecha comanda vê o caixa aberto e soma a venda nele (só os totais de vendas);
    // abrir, movimentar e fechar o caixa seguem a permissão do próprio cadastro (acima)
    match /caixas/{id} {
      allow read: if podeEmAlgum(['consumos', 'comandas'], 'criar') || podeEmAlgum(['consumos', 'comandas'], 'editar');
      allow update: if resource.data.status == 'Aberto' && request.resource.data.status == 'Aberto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendas', 'totalVendas', 'qtdVendas'])
        && (podeEmAlgum(['consumos', 'comandas'], 'criar') || podeEmAlgum(['consumos', 'comandas'], 'editar') || pode('consumos', 'excluir'));
    }
    // o afilhado acompanha a própria comanda no aplicativo
    match /comandas/{id} {
      allow read: if logado() && resource.data.get('clienteUid', '') == request.auth.uid;
    }

    /* ---------- painel de atualizações ---------- */
    // histórico de quem fez o quê: cada área vê o próprio; só se acrescenta, nunca se altera ou apaga
    match /atividades/{area}/itens/{id} {
      allow read: if podeVer(area);
      allow create: if podeAlterar(area)
        && request.resource.data.keys().hasOnly(['area', 'acao', 'colecao', 'alvo', 'detalhe', 'usuarioId', 'usuarioNome', 'criadoEm',
          'registroId', 'antes', 'depois', 'omitidos', 'desfaz'])
        // histórico detalhado (Logs de alterações): o registro e os valores de antes e de depois
        && request.resource.data.get('registroId', '') is string && request.resource.data.get('registroId', '').size() <= 128
        && request.resource.data.get('desfaz', '') is string && request.resource.data.get('desfaz', '').size() <= 128
        && request.resource.data.get('antes', {}) is map && request.resource.data.get('antes', {}).size() <= 100
        && request.resource.data.get('depois', {}) is map && request.resource.data.get('depois', {}).size() <= 100
        && request.resource.data.get('omitidos', []) is list && request.resource.data.get('omitidos', []).size() <= 50
        && request.resource.data.area == area
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioNome == get(caminho('usuarios', request.auth.uid)).data.nome
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 120
        && request.resource.data.alvo is string && request.resource.data.alvo.size() <= 160
        && request.resource.data.detalhe is string && request.resource.data.detalhe.size() <= 300;
      // só o Administrador, ao zerar o sistema
      allow delete: if sistema();
    }

    /* ---------- preferências de cada usuário (painel executivo personalizado) ---------- */
    // cada painel (executivo e "Meu painel") guarda só listas curtas de identificadores
    function painelOk(p) {
      return p.keys().hasOnly(['ordem', 'fixados', 'ocultos', 'atalhos', 'extras', 'tamanhos', 'layout'])
        && p.get('ordem', []) is list && p.get('ordem', []).size() <= 60
        && p.get('fixados', []) is list && p.get('fixados', []).size() <= 60
        && p.get('ocultos', []) is list && p.get('ocultos', []).size() <= 60
        && p.get('atalhos', []) is list && p.get('atalhos', []).size() <= 30
        && p.get('extras', []) is list && p.get('extras', []).size() <= 60
        && p.get('tamanhos', {}) is map && p.get('tamanhos', {}).size() <= 60
        && p.get('layout', {}) is map && p.get('layout', {}).size() <= 60;
    }
    match /preferencias/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if daEquipe() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['painel', 'meuPainel', 'paginas', 'atualizadoEm'])
        && request.resource.data.get('paginas', []) is list && request.resource.data.get('paginas', []).size() <= 30
        && painelOk(request.resource.data.get('painel', {}))
        && painelOk(request.resource.data.get('meuPainel', {}));
      allow delete: if sistema();
    }

    /* ---------- primeiro acesso ---------- */
    // o primeiro administrador, a função Administrador e a marca de "configurado" são gravados juntos, uma única vez
    function primeiroAcesso() {
      return logado()
        && !exists(caminho('meta', 'setup')) && existsAfter(caminho('meta', 'setup'))
        && getAfter(caminho('usuarios', request.auth.uid)).data.funcaoId == 'admin';
    }
    match /meta/setup {
      allow read: if true;
      allow create: if primeiroAcesso();
      allow delete: if sistema();
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || daEquipe());
      allow create: if pode('usuarios', 'criar') || (request.auth.uid == uid && primeiroAcesso());
      allow update: if pode('usuarios', 'editar')
        || (logado() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcesso']))
        // Meu perfil: a própria pessoa edita nome, telefone, nascimento, "sobre mim" e foto (nunca função, status ou e-mail)
        || (daEquipe() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'nascimento', 'sobre', 'foto'])
          && (request.resource.data.get('foto', null) == null || (request.resource.data.foto is string && request.resource.data.foto.size() <= 400000))
          && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
          && request.resource.data.get('telefone', '') is string && request.resource.data.get('telefone', '').size() <= 20
          && request.resource.data.get('nascimento', '') is string && request.resource.data.get('nascimento', '').size() <= 10
          && request.resource.data.get('sobre', '') is string && request.resource.data.get('sobre', '').size() <= 500);
      allow delete: if (pode('usuarios', 'excluir') && request.auth.uid != uid) || (request.auth.uid == uid && zerando());
    }

    match /funcoes/{id} {
      allow read: if daEquipe();
      allow create: if (pode('funcoes', 'criar') && request.resource.data.get('sistema', false) != true)
        || (id == 'admin' && primeiroAcesso());
      allow update: if (pode('funcoes', 'editar') && resource.data.get('sistema', false) != true && request.resource.data.get('sistema', false) != true)
        // primeiro acesso refeito (ex.: registro apagado no console): recria a função Administrador que sobrou
        || (id == 'admin' && primeiroAcesso());
      allow delete: if (pode('funcoes', 'excluir') && resource.data.get('sistema', false) != true) || zerando();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if pode('parametros', 'editar');
    }
    // chaves de serviços (ex.: IA que lê as notas fiscais): só a equipe logada lê; só quem edita Configurações grava
    match /segredos/{id} {
      allow read: if daEquipe();
      allow write: if pode('parametros', 'editar');
    }

    /* ---------- cópias com dados reduzidos ---------- */
    // cardápio público (sem custo nem margem dos produtos)
    match /cardapio/{id} {
      allow read: if true;
      allow write: if podeEmAlgum(['produtos', 'fichas'], 'criar') || podeEmAlgum(['produtos', 'fichas'], 'editar') || podeEmAlgum(['produtos', 'fichas'], 'excluir');
    }
    // nomes para vincular registros, visíveis a toda a equipe (sem salários nem contatos)
    match /ref_colaboradores/{id} {
      allow read: if daEquipe();
      allow write: if podeAlterar('colaboradores');
    }
    match /ref_fornecedores/{id} {
      allow read: if daEquipe();
      allow write: if podeAlterar('fornecedores');
    }

    /* ---------- acessos cruzados entre áreas ---------- */
    // a folha de pagamento é calculada a partir do cadastro de colaboradores (e o Financeiro vê os totais)
    match /colaboradores/{id} {
      allow read: if podeEmAlgum(['folha', 'despesas'], 'ver');
    }
    // a ficha técnica (produtos e guarnições) usa os insumos e custos do Estoque; a Tabela de preços escolhe o insumo;
    // a Entrada de notas soma (ou estorna) as quantidades e atualiza o custo dos itens
    match /estoque/{id} {
      allow read: if podeEmAlgum(['produtos', 'fichas', 'guarnicoes', 'precos', 'compras'], 'ver');
      allow create, update: if podeEmAlgum(['compras'], 'criar') || pode('compras', 'excluir');
    }
    // o preparo da ficha técnica escolhe copos e utensílios do cadastro de Materiais; a Entrada de notas soma os materiais
    match /materiais/{id} {
      allow read: if podeEmAlgum(['produtos', 'fichas', 'compras'], 'ver');
      allow create, update: if podeEmAlgum(['compras'], 'criar') || pode('compras', 'excluir');
    }
    // a ficha técnica compara os preços de cada fornecedor; a Entrada de notas atualiza o preço do fornecedor;
    // o cadastro do fornecedor mostra o que compramos dele
    match /precos/{id} {
      allow read: if podeEmAlgum(['produtos', 'fichas', 'compras', 'fornecedores'], 'ver');
    }
    // o lançamento de consumo usa os preços do cadastro de produtos
    match /produtos/{id} {
      allow read: if podeEmAlgum(['consumos', 'comandas'], 'ver');
    }
    // o lançamento de consumo gera e estorna a própria receita; o Resultado (DRE) lê receitas e despesas
    match /receitas/{id} {
      allow read: if podeEmAlgum(['resultado', 'ticket', 'renda'], 'ver');
      allow create: if (pode('consumos', 'criar') && request.resource.data.consumoId is string)
        // comanda sem afilhado: fechar a comanda lança a venda direto na receita
        || (pode('comandas', 'editar') && request.resource.data.comandaId is string && request.resource.data.get('consumoId', null) == null);
      allow delete: if pode('consumos', 'excluir') && resource.data.get('consumoId', null) != null && vendaDeCaixaAberto(resource.data);
      // corrigir a venda (com o caixa dela aberto) ajusta valor e forma de pagamento da receita que ela gerou
      allow update: if pode('consumos', 'editar') && resource.data.get('consumoId', null) is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valor', 'formaPagamento', 'atualizadoEm'])
        && get(caminho('caixas', resource.data.caixaId)).data.status == 'Aberto'
        && getAfter(caminho('consumos', resource.data.consumoId)).data.valor == request.resource.data.valor;
    }

    // cada área lança no DRE as despesas dos próprios cadastros (botão "Lançar despesa"), sem ganhar acesso ao Financeiro:
    // só cria, sempre "A pagar", em nome próprio, ligada a um registro que existe e que a pessoa pode editar.
    // O mesmo lote anota o lançamento no cadastro de origem (rastro para a área e aviso de repetição na competência).
    function origensDeDespesa() { return ['terceirizados', 'contratos', 'midias', 'projetos', 'compras']; }
    function dataIso(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function textoAte(v, max) { return v is string && v.size() <= max; }
    // as variáveis (let) e a ordem das condições mantêm a avaliação dentro do limite de expressões das regras:
    // primeiro o que só olha para a própria despesa, por último o que consulta outros documentos
    function despesaDeOrigem(id) {
      let d = request.resource.data;
      let col = d.get('origemColecao', '');
      return col in origensDeDespesa()
        && d.keys().hasOnly(['descricao', 'categoria', 'data', 'vencimento', 'valor', 'status', 'observacoes', 'origem', 'origemColecao', 'origemId', 'criadoPor', 'criadoEm', 'atualizadoEm'])
        && d.criadoPor == request.auth.uid
        && textoAte(d.origemId, 128) && d.origemId.size() > 0 && !d.origemId.matches('.*/.*')
        && dataIso(d.data)
        && d.status == 'A pagar'
        && d.valor is number && d.valor > 0 && d.valor <= 1000000
        && textoAte(d.descricao, 200) && d.descricao.size() >= 3
        && textoAte(d.categoria, 40) && d.categoria.size() >= 1
        && (d.get('vencimento', '') == '' || dataIso(d.vencimento))
        && textoAte(d.get('observacoes', ''), 1000)
        && textoAte(d.origem, 80) && textoAte(d.criadoEm, 40) && textoAte(d.atualizadoEm, 40)
        && pode(col, 'editar')
        && exists(caminho(col, d.origemId))
        && getAfter(caminho(col, d.origemId)).data.lancamentos[d.data[0:7]].despesaId == id;
    }
    match /despesas/{id} {
      allow read: if podeEmAlgum(['resultado', 'ticket', 'renda'], 'ver');
      allow create: if despesaDeOrigem(id);
    }

    /* ---------- PDFs anexados aos cadastros ---------- */
    // o arquivo fica fora do registro (que guarda só nome e tamanho), em partes de até 900 mil caracteres (base64).
    // Vale a permissão da área do cadastro de origem: quem vê o cadastro abre o PDF; quem cria ou edita anexa.
    function colecoesComAnexo() {
      return ['metas', 'colaboradores', 'ferias', 'projetos', 'materiais', 'patrimonio', 'compras', 'terceirizados', 'fornecedores', 'contratos',
        'receitas', 'despesas', 'criacao', 'trabalhista', 'consultoria', 'qualidade', 'naoconformidades',
        'publicidade', 'atestados', 'acoes', 'creditos', 'docfin', 'investimentos', 'prestadores', 'conduta', 'advogados', 'normas', 'equipamentos'];
    }
    function anexaEm(col) { return col in colecoesComAnexo() && (podeColecao(col, 'criar') || podeColecao(col, 'editar')); }
    // apaga quem edita ou exclui na área, ou quem enviou o arquivo (desfaz um envio quando o registro não chega a ser gravado)
    function apagaAnexo(a) {
      return podeColecao(a.colecao, 'editar') || podeColecao(a.colecao, 'excluir') || (a.criadoPor == request.auth.uid && anexaEm(a.colecao));
    }
    match /anexos/{id} {
      allow read: if resource.data.colecao in colecoesComAnexo() && podeColecao(resource.data.colecao, 'ver');
      allow create: if request.resource.data.keys().hasOnly(['colecao', 'registroId', 'nome', 'tamanho', 'partes', 'criadoPor', 'criadoEm'])
        && request.resource.data.criadoPor == request.auth.uid
        && textoAte(request.resource.data.nome, 160) && request.resource.data.nome.size() > 0
        && textoAte(request.resource.data.registroId, 128) && request.resource.data.registroId.size() > 0
        && textoAte(request.resource.data.criadoEm, 40)
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 5242880
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 8
        && anexaEm(request.resource.data.colecao);
      allow delete: if apagaAnexo(resource.data);

      match /partes/{n} {
        allow read: if podeColecao(get(caminho('anexos', id)).data.colecao, 'ver');
        // só junto com o registro do arquivo (mesmo lote) e dentro do número de partes declarado
        allow create: if !exists(caminho('anexos', id)) && existsAfter(caminho('anexos', id))
          && request.resource.data.keys().hasOnly(['dados'])
          && request.resource.data.dados is string && request.resource.data.dados.size() > 0 && request.resource.data.dados.size() <= 900000
          && n.matches('^[0-7]$') && int(n) < getAfter(caminho('anexos', id)).data.partes
          && anexaEm(getAfter(caminho('anexos', id)).data.colecao);
        allow delete: if apagaAnexo(get(caminho('anexos', id)).data);
      }
    }

    /* ---------- afilhados (aplicativo) ---------- */
    function novoCliente() {
      return logado() && !exists(caminho('clientes', request.auth.uid)) && existsAfter(caminho('clientes', request.auth.uid));
    }
    // contador que dá o número sequencial de afilhado: só anda de um em um, junto com um cadastro novo
    match /meta/contadores {
      allow read: if true;
      allow create: if request.resource.data.clientes == 1 && novoCliente();
      allow update: if request.resource.data.clientes == resource.data.clientes + 1 && novoCliente();
      // o Administrador ajusta a numeração (ex.: depois de excluir afilhados de teste) ou a apaga ao zerar o sistema
      allow create, update: if pode('parametros', 'editar') && request.resource.data.keys().hasOnly(['clientes'])
        && request.resource.data.clientes is int && request.resource.data.clientes >= 0;
      allow delete: if sistema();
    }
    // afilhados e saldos: quem atende (reservas, consumos, vouchers), vende (clientes) ou cuida das recompensas
    function verAfilhados() {
      return podeEmAlgum(['clientes', 'reservas', 'consumos', 'resgates', 'recompensas'], 'ver') || pode('comandas', 'ver');
    }
    // programa de afilhados: só maiores de 18 anos (pela data de nascimento) e com CPF; um CPF por afilhado
    function cpfOk(v) { return v is string && v.matches('^[0-9]{11}$'); }
    function maiorDeIdade(n) {
      return n is string && n.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && timestamp.date(int(n[0:4]) + 18, int(n[5:7]), n[5:7] == '02' && int(n[8:10]) > 28 ? 28 : int(n[8:10])) <= request.time;
    }
    function cpfDoAfilhado(uid, cpf) { return existsAfter(caminho('cpfs', cpf)) && getAfter(caminho('cpfs', cpf)).data.uid == uid; }
    match /clientes/{uid} {
      allow read: if logado() && (request.auth.uid == uid || verAfilhados());
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.numero == getAfter(caminho('meta', 'contadores')).data.clientes
        && cpfOk(request.resource.data.get('cpf', null)) && maiorDeIdade(request.resource.data.get('nascimento', null))
        && cpfDoAfilhado(uid, request.resource.data.cpf)
        && existsAfter(caminho('saldos', uid));
      // o próprio afilhado edita nome, telefone, foto e as respostas do questionário opcional;
      // cadastros de antes do lançamento completam CPF e data de nascimento uma única vez
      allow update: if logado() && request.auth.uid == uid
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'foto', 'respostas'])
          || (!('cpf' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'foto', 'respostas', 'cpf', 'nascimento'])
            && cpfOk(request.resource.data.cpf) && maiorDeIdade(request.resource.data.nascimento)
            && cpfDoAfilhado(uid, request.resource.data.cpf)));
      // excluir o afilhado (a pedido dele, LGPD) ou ao zerar o sistema
      allow delete: if pode('clientes', 'excluir');
    }

    // um registro por CPF, criado junto com o afilhado que o usa (não dá para criar de novo nem trocar o dono);
    // ninguém lê (não serve para descobrir se um CPF está cadastrado); a equipe apaga junto com o afilhado
    match /cpfs/{cpf} {
      allow create: if logado() && cpfOk(cpf) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(caminho('clientes', request.auth.uid)).data.cpf == cpf;
      allow delete: if pode('clientes', 'excluir') || zerando();
    }

    // saldo de pontos usado para validar resgates: quem credita é a equipe; o cliente só debita junto com um voucher
    match /saldos/{uid} {
      function liquido(d) { return d.get('acumulados', 0) - d.get('usados', 0); }
      function saldoValido() {
        return request.resource == null || liquido(request.resource.data) >= 0
          || (resource != null && liquido(request.resource.data) >= liquido(resource.data));
      }
      allow read: if logado() && (request.auth.uid == uid || verAfilhados());
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['acumulados', 'usados', 'ultimoResgate'])
        && request.resource.data.acumulados == 0 && request.resource.data.usados == 0;
      // a equipe ajusta o saldo, mas nunca o deixa negativo (só pode melhorar um saldo que já estava negativo)
      allow write: if (podeEmAlgum(['consumos', 'resgates'], 'criar') || podeEmAlgum(['consumos', 'resgates'], 'editar') || podeEmAlgum(['consumos', 'resgates'], 'excluir')) && saldoValido();
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usados', 'ultimoResgate'])
        && request.resource.data.ultimoResgate != resource.data.ultimoResgate
        && !exists(caminho('resgates', request.resource.data.ultimoResgate))
        && getAfter(caminho('resgates', request.resource.data.ultimoResgate)).data.clienteUid == uid
        && request.resource.data.usados == resource.data.usados + getAfter(caminho('resgates', request.resource.data.ultimoResgate)).data.custo
        && request.resource.data.usados <= resource.data.acumulados;
    }

    match /recompensas/{id} {
      allow read: if resource.data.status == 'Ativa';
    }

    match /reservas/{id} {
      // o Calendário mostra as reservas de cada dia
      allow read: if (logado() && resource.data.clienteUid == request.auth.uid) || podeVer('eventos');
      allow create: if logado() && request.resource.data.clienteUid == request.auth.uid
        && exists(caminho('clientes', request.auth.uid))
        && request.resource.data.status == 'Pendente' && request.resource.data.origem == 'Aplicativo';
      allow update: if logado() && resource.data.clienteUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && request.resource.data.status == 'Cancelada pelo cliente'
        && resource.data.status in ['Pendente', 'Confirmada'];
    }

    match /consumos/{id} {
      allow read: if (logado() && resource.data.clienteUid == request.auth.uid) || podeEmAlgum(['clientes', 'recompensas'], 'ver');
    }

    match /resgates/{id} {
      allow read: if (logado() && resource.data.clienteUid == request.auth.uid) || podeEmAlgum(['clientes', 'recompensas'], 'ver');
      allow create: if logado() && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.status == 'Disponível'
        && get(caminho('recompensas', request.resource.data.recompensaId)).data.status == 'Ativa'
        && request.resource.data.custo == get(caminho('recompensas', request.resource.data.recompensaId)).data.custo
        && request.resource.data.custo > 0
        && getAfter(caminho('saldos', request.auth.uid)).data.ultimoResgate == id;
    }
  }
}
